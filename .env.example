# No environment variables are required.
# Optional: override cache lifetimes (seconds).
# QUOTE_TTL_SECONDS=60
# HISTORY_TTL_SECONDS=600
# NEWS_TTL_SECONDS=300

# Optional: dashboard sync codes need an Upstash Redis database.
# On Vercel the Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Leaders tab. SEC EDGAR rejects requests without a contact in the User-Agent.
# SEC_USER_AGENT=YourApp/1.0 (you@example.com)
# Free key from bargo.ai raises the Congress feed limit (hourly refresh instead of 6-hourly).
# BARGO_API_KEY=

# Optional: login. AUTH_SECRET alone enables sign-up and regular login.
# ADMIN_EMAIL + ADMIN_PASSWORD_HASH additionally enable the admin login (fake-user impersonation).
# ADMIN_EMAIL=admin@example.test
# Make the hash (scrypt, no dependency):
#   node -e "const c=require('node:crypto');const s=c.randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" "your-password"
# ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
# Optional: name shown in the header for the admin (default "Admin").
# ADMIN_NAME=
# Signs the session cookie; 16+ random characters, e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=
# Optional: POST every identify/track event as JSON to your customer engagement platform.
# CEP_WEBHOOK_URL=

# Optional: sign-up is on by default (needs Redis in production). Set to 1 to turn it off:
# the signup route returns 403 and the Sign up links are hidden.
# SIGNUP_DISABLED=1
